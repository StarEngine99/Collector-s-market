APP_NAME="Chợ Figure & Thẻ Bài"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=model_store
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Chế độ Demo Quên mật khẩu (A6): Mặc định tắt (false).
# Đổi thành true khi cần hiển thị trực tiếp link đặt lại mật khẩu trên màn hình.
PASSWORD_RESET_DEMO=false

# Thông tin tài khoản ngân hàng mẫu cho phương thức Chuyển khoản (A5)
# Chỉ để giá trị giả trong .env.example; điền thông tin thật vào file .env trên máy chạy demo.
BANK_TRANSFER_BANK_NAME="Ngân hàng TMCP Demo (DemoBank)"
BANK_TRANSFER_ACCOUNT_NUMBER="0123456789"
BANK_TRANSFER_ACCOUNT_HOLDER="NGUYEN VAN DEMO"
BANK_TRANSFER_BRANCH="Chi nhánh Đồng Tháp"

